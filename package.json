{
  "name": "engine-sound-lab",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.mjs tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "tsx": "^4.20.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
