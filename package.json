{
  "name": "engine-sound-lab",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "build": "vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.mjs tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build && node --test tests/pwa-build.verify.mjs",
    "test:visual": "playwright test --config=playwright.config.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "tsx": "^4.20.0",
    "@types/node": "^22.0.0",
    "@playwright/test": "^1.56.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
